{
	"folders": [
		{ "path": "." },
		{ "path": "../vibe-coding" },
		{ "path": "../setup-guides" },
		{ "path": "../sofia-utils" },
		{ "path": "../wa-agents" },
		{ "path": "../sofia-server" },
		{ "path": "../sofia-server/backend/case_handlers/da_assistant" },
		{ "path": "../sofia-server/backend/case_handlers/ieced" },
		{ "path": "../sofia-server/backend/case_handlers/tia_chatbots" },
		{ "path": "../tv_model_guided" },
	],
	"settings": {
		
		// PYTHON VIRTUAL ENVIRONMENT
		"python.defaultInterpreterPath": "${env:HOME}/pe/bin/python",
		
		// ALL OTHER SETTINGS IN ALPHABETICAL ORDERING
		
		// ChatGPT Codex
		"chatgpt.commentCodeLensEnabled": false,
		
		// Cursor Pyright
		"cursorpyright.analysis.autoImportCompletions": true,
		"cursorpyright.analysis.diagnosticMode": "openFilesOnly",
		"cursorpyright.analysis.diagnosticSeverityOverrides": {
			"reportGeneralTypeIssues": "none",
		},
		"cursorpyright.analysis.extraPaths": [
			"${env:HOME}/sofia-utils",
			"${env:HOME}/wa-agents",
		],
		"cursorpyright.analysis.typeCheckingMode": "off",
		"cursorpyright.nodeMaxOldSpaceSize": 4096,
		
		// Editor
		"editor.autoIndent": "keep",
		"editor.formatOnPaste": false,
		"editor.inlayHints.enabled": "off",
		"editor.inlineSuggest.edits.renderSideBySide": "never",
		"editor.renderWhitespace": "all",
		"editor.trimAutoWhitespace": false,
		"editor.wordWrapColumn": 92,
		"editor.wordWrap": "wordWrapColumn", // Wraps at the above column
		"editor.wrappingIndent": "same",     // Keeps indentation when wrapping
		"explorer.autoReveal": false,
		"explorer.autoRevealExclude": {
			"**/node_modules": true,
			"**/.git": true,
		},
		"explorer.sortOrder": "default",
		
		// Files
		"files.associations": {
			"*.env": "properties",
			".env.*.json": "json",
			".env.*.jsonc": "jsonc",
			".env.*.jsonl": "jsonl",
		},
		"files.trimFinalNewlines": true,
		"files.trimTrailingWhitespace": false,
		
		// JSON
		"[json]": {
			"editor.quickSuggestions": {
				"strings": true
			},
			"editor.suggest.insertMode": "replace",
			"editor.tabSize": 2,
		},
		"json.schemaDownload.enable": true,
		
		// Markdown
		"[markdown]": {
			"editor.tabSize": 2,
			"editor.insertSpaces": true,
			"editor.detectIndentation": false,
		},
		"markdown.preview.scrollEditorWithPreview": false,
		"markdown.preview.scrollPreviewWithEditor": false,
		
		// SQL
		"[sql]": {
			"editor.tabSize": 2,
			"editor.insertSpaces": true,
			"editor.detectIndentation": false,
		},
		
		// Workbench
		"workbench.editor.enablePreview": false,
		"workbench.editor.enablePreviewFromQuickOpen": false,
		"workbench.editor.openPositioning": "last",
		"workbench.editor.openSideBySideDirection": "down",
		"workbench.editorAssociations": {
			"*.svg": "default",
		},
		"workbench.sideBar.location": "right",
	
	},
}
